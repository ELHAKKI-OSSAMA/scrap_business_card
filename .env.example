# Copy to .env and fill in. Never commit .env. In production use a secret manager.

# --- required secrets -----------------------------------------------------------
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=

# --- general ------------------------------------------------------------------
ENVIRONMENT=development            # development | production
HTTP_PORT=8080
IMAGE_TAG=latest
LOG_LEVEL=INFO
POSTGRES_USER=ocr
POSTGRES_DB=ocr
ALLOW_REGISTRATION=true            # set false in production and create users with `python -m app.cli create-user`
CORS_ORIGINS=                      # only needed when web apps are served from another origin

# --- uploads / security ---------------------------------------------------------
MAX_UPLOAD_MB=15
MALWARE_SCANNER=none               # none | clamav (start with --profile clamav)

# --- storage --------------------------------------------------------------------
STORAGE_BACKEND=local              # local | s3
S3_ENDPOINT_URL=http://minio:9000  # empty for AWS S3
S3_BUCKET=ocr-suite
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- OCR ------------------------------------------------------------------------
OCR_PROVIDER=paddleocr             # paddleocr | tesseract
OCR_FALLBACK_PROVIDER=tesseract    # used only if the primary is unavailable (recorded on the job)
OCR_DET_MODEL=PP-OCRv5_mobile_det  # PP-OCRv5_server_det is more accurate, ~4x slower on CPU
OCR_DET_MODEL_GPU=PP-OCRv5_server_det

# --- extraction -------------------------------------------------------------------
DEFAULT_PHONE_REGION=              # e.g. MA – used only for numbers without +country prefix
# Optional LLM-assisted extraction. OFF by default; nothing leaves the server unless configured.
LLM_PROVIDER=none                  # none | openai_compatible
LLM_BASE_URL=                      # e.g. http://ollama:11434/v1 (self-hosted) or a hosted endpoint
LLM_MODEL=
LLM_API_KEY=

# --- optional machine translation (separate, labelled machine-generated) ----------
TRANSLATION_PROVIDER=none          # none | libretranslate
TRANSLATION_URL=

# --- retention ------------------------------------------------------------------
DELETED_RETENTION_DAYS=30
DOCUMENT_RETENTION_DAYS=0          # 0 = keep until deleted

# --- monitoring profile -----------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- production TLS -------------------------------------------------------------
TLS_CERT_DIR=./certs
WORKER_REPLICAS=2
